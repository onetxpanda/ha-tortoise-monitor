[Unit]
Description=Tortoise Monitor training server (add-on at __ADDON__)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=__BASE__
Environment=PYTHONUNBUFFERED=1 HOME=/root TM_SERVER_HOME=__BASE__ YOLO_CONFIG_DIR=__BASE__/cache/ultralytics
ExecStart=__BASE__/venv/bin/python __BASE__/current/tortoise_worker.py run
# exits with 75 after installing an update from the add-on: restart into it
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
